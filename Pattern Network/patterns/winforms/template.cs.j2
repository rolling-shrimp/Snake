{% if role == "form" %}
namespace {{ namespace_name }}
{
    public partial class {{ game_name }}Form : System.Windows.Forms.Form
    {
{% for use_case in use_cases %}
        private {{ use_case.type }} _{{ use_case.name }};
{% endfor %}
        private System.Windows.Forms.Timer _gameTimer;
        private {{ screen_dto_type }}? _currentScreen;

        public {{ game_name }}Form({{ constructor_parameters }})
        {
{{ constructor_body | indent(12, true) }}
            _gameTimer = new System.Windows.Forms.Timer
            {
                Interval = 250
            };
            InitializeComponent();
{{ initialization_body | indent(12, true) }}
        }

{% for interaction in interactions %}
        private {{ interaction.return_type }} {{ interaction.name }}({{ interaction.parameters }})
        {
{{ interaction.body | indent(12, true) }}
        }
{% endfor %}

        private void ApplyScreen({{ screen_dto_type }} gameScreenDTO)
        {
            {{ screen_dto_type }}? previousScreen = _currentScreen;
            _currentScreen = gameScreenDTO;
{{ render_body | indent(12, true) }}
        }
    }
}
{% endif %}
